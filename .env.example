# ==========================================================
# Variáveis de Ambiente — EventEase (Modelo VPS / Docker)
# ==========================================================

# ----------------------------------------------------------
# 1. Banco de Dados (Supabase PostgreSQL / PostgreSQL Local)
# ----------------------------------------------------------
DATABASE_URL="postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ----------------------------------------------------------
# 2. Segurança da API (JWT & Cookie Secrets)
# ----------------------------------------------------------
JWT_SECRET="gere-um-segredo-hexadecimal-forte-para-jwt"
JWT_REFRESH_SECRET="gere-outro-segredo-hexadecimal-forte-para-refresh"
COOKIE_SECRET="gere-outro-segredo-forte-para-cookies"

# ----------------------------------------------------------
# 3. URL do Frontend (CORS)
# Cole o seu domínio (ex: https://seu-dominio.com) ou IP da VPS (ex: http://181.215.45.185)
# ----------------------------------------------------------
FRONTEND_URL="http://localhost:3000"

# ----------------------------------------------------------
# 4. Configuração do Redis
# - Docker Compose: REDIS_HOST é 'redis' (nome do container)
# - Imagem única (Dockerfile raiz / Easypanel): já vem com REDIS_HOST=127.0.0.1
#   embutido na imagem — não precisa configurar nada aqui
# ----------------------------------------------------------
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
CACHE_STORE=redis
SESSION_DRIVER="file"
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000,127.0.0.1:8000

# ----------------------------------------------------------
# 5. Google reCAPTCHA v3
# ----------------------------------------------------------
VITE_RECAPTCHA_SITE_KEY="sua-chave-publica-recaptcha-v3"
RECAPTCHA_SECRET_KEY="sua-chave-secreta-recaptcha-v3"
RECAPTCHA_MIN_SCORE="0.5"

# ----------------------------------------------------------
# 6. Supabase API & Auth Keys
# ----------------------------------------------------------
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="sua-chave-anon-aqui"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-aqui"

# ----------------------------------------------------------
# 7. Integração NevaPro Webhook
# ----------------------------------------------------------
NEVAPRO_WEBHOOK_URL="https://nevapro.olharjovem.org/api/webhooks/eventease"
NEVAPRO_WEBHOOK_SECRET="sua-chave-secreta-webhook"

# ----------------------------------------------------------
# 8. Modo de Manutenção (false para o site ficar online)
# ----------------------------------------------------------
VITE_MAINTENANCE_MODE="false"
