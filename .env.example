# ==========================================
# Variáveis de Ambiente — EventEase VPS
# ==========================================

# DATABASE_URL: String de conexão com o PostgreSQL na VPS
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgresql://USUARIO_DB:SENHA_DB@181.215.45.185:5433/eventease"

# JWT_SECRET: Chave secreta para assinar os tokens JWT
# Gere uma chave forte: openssl rand -hex 32
JWT_SECRET="sua-chave-jwt-secreta-aqui"

# COOKIE_SECRET: Chave para assinar os cookies de sessão
COOKIE_SECRET="sua-chave-cookie-secreta-aqui"

# FRONTEND_URL: URL do frontend (usada no CORS do backend)
# Ex: https://seudominio.com ou http://181.215.45.185
FRONTEND_URL="http://181.215.45.185"
