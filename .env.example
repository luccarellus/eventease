# ==========================================================
# Variáveis de Ambiente — EventEase (Vercel + Supabase)
# ==========================================================

# DATABASE_URL: URL do Supabase com pooling de conexões (porta 6543)
# Usada pela API NestJS em produção. IMPORTANTE: Adicione ?pgbouncer=true no final se usar PgBouncer.
DATABASE_URL="postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: URL do Supabase de conexão direta (porta 5432)
# Usada pelo Prisma para realizar migrações e push de banco (DDL).
DIRECT_URL="postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# JWT_SECRET: Chave secreta para assinar os tokens JWT (mínimo 32 caracteres)
# Gere com: openssl rand -hex 32
JWT_SECRET="sua-chave-jwt-secreta-aqui"

# COOKIE_SECRET: Chave para assinar os cookies de sessão HTTPOnly
COOKIE_SECRET="sua-chave-cookie-secreta-aqui"

# FRONTEND_URL: URL do frontend (usada no CORS do backend)
# Em produção na Vercel: https://seu-app.vercel.app
FRONTEND_URL="http://localhost:3000"

# SUPABASE_URL: URL do projeto Supabase
SUPABASE_URL="https://xxxx.supabase.co"

# SUPABASE_ANON_KEY: chave pública do Supabase Auth
SUPABASE_ANON_KEY="sua-chave-anon-aqui"

# SUPABASE_SERVICE_ROLE_KEY: chave secreta usada pelo backend para operações administrativas
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-aqui"
