generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// ==========================================
// Admin Users (Sincronizado com Supabase Auth)
// ==========================================
model AdminUser {
  id            String    @id @db.Uuid
  email         String    @unique
  fullName      String?   @map("full_name")
  role          String    @default("admin")
  
  createdAt     DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt     DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  @@map("admin_users")
}

// ==========================================
// Participantes
// ==========================================
model Participante {
  id              String    @id @default(uuid()) @db.Uuid
  nome            String
  email           String    @unique
  telefone        String
  empresa         String?   // 'Instituição' no UI
  cidade          String
  escola          String
  gremio          String?
  codigo          String    @unique
  
  aceitou_termos  Boolean   @default(false)
  termos_aceitos_em DateTime? @db.Timestamptz

  createdAt       DateTime  @default(now()) @db.Timestamptz @map("created_at")

  inscricoes      InscricaoEvento[]

  @@index([codigo])
  @@map("participantes")
}

// ==========================================
// Eventos
// ==========================================
model Evento {
  id                  String    @id @default(uuid()) @db.Uuid
  titulo              String
  descricao           String?
  data                DateTime  @db.Timestamptz
  local               String
  cidade              String?
  publicado           Boolean   @default(false)
  dataInicioInscricao DateTime? @db.Timestamptz @map("data_inicio_inscricao")
  dataFimInscricao    DateTime? @db.Timestamptz @map("data_fim_inscricao")
  
  createdAt           DateTime  @default(now()) @db.Timestamptz @map("created_at")

  inscricoes          InscricaoEvento[]

  @@index([publicado])
  @@map("eventos")
}

// ==========================================
// Inscrições de Eventos
// ==========================================
model InscricaoEvento {
  id              String    @id @default(uuid()) @db.Uuid
  eventoId        String    @db.Uuid @map("evento_id")
  participanteId  String    @db.Uuid @map("participante_id")
  presente        Boolean   @default(false)
  confirmado_em   DateTime? @db.Timestamptz
  
  createdAt       DateTime  @default(now()) @db.Timestamptz @map("created_at")

  evento          Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  participante    Participante @relation(fields: [participanteId], references: [id], onDelete: Cascade)

  @@unique([eventoId, participanteId], name: "unique_evento_participante")
  @@index([eventoId])
  @@index([participanteId])
  @@map("inscricoes_evento")
}

// ==========================================
// Refresh Tokens (para rotação e revogação)
// ==========================================
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid @map("user_id")
  tokenHash   String    @map("token_hash")
  expiresAt   DateTime  @db.Timestamptz @map("expires_at")
  revokedAt   DateTime? @db.Timestamptz @map("revoked_at")
  createdAt   DateTime  @default(now()) @db.Timestamptz @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}
