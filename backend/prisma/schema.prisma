generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// User Authentication (Substitui Supabase Auth)
// ==========================================
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  fullName      String?
  role          String    @default("admin") // Role 'admin' for the dashboard
  
  // LGPD Fields (se necessário futuramente)
  acceptedTerms Boolean   @default(false)
  termsAcceptedAt DateTime?
  dataConsent   Boolean   @default(false)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

// ==========================================
// Participantes
// ==========================================
model Participante {
  id              String    @id @default(uuid()) @db.Uuid
  nome            String
  email           String
  telefone        String
  empresa         String?   // 'Instituição' no UI
  cidade          String
  escola          String
  gremio          String?
  codigo          String    @unique
  
  aceitou_termos  Boolean   @default(false)
  termos_aceitos_em DateTime? @db.Timestamptz

  createdAt       DateTime  @default(now()) @db.Timestamptz @map("created_at")

  inscricoes      InscricaoEvento[]

  @@index([codigo])
  @@index([email])
  @@map("participantes")
}

// ==========================================
// Eventos
// ==========================================
model Evento {
  id              String    @id @default(uuid()) @db.Uuid
  titulo          String
  descricao       String?
  data            DateTime  @db.Timestamptz
  local           String
  publicado       Boolean   @default(false)
  
  createdAt       DateTime  @default(now()) @db.Timestamptz @map("created_at")

  inscricoes      InscricaoEvento[]

  @@index([publicado])
  @@map("eventos")
}

// ==========================================
// Inscrições de Eventos
// ==========================================
model InscricaoEvento {
  id              String    @id @default(uuid()) @db.Uuid
  eventoId        String    @db.Uuid @map("evento_id")
  participanteId  String    @db.Uuid @map("participante_id")
  presente        Boolean   @default(false)
  confirmado_em   DateTime? @db.Timestamptz
  
  createdAt       DateTime  @default(now()) @db.Timestamptz @map("created_at")

  evento          Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  participante    Participante @relation(fields: [participanteId], references: [id], onDelete: Cascade)

  @@unique([eventoId, participanteId], name: "unique_evento_participante")
  @@index([eventoId])
  @@index([participanteId])
  @@map("inscricoes_evento")
}
