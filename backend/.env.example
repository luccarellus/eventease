# Database Configuration (Supabase PostgreSQL)
# DATABASE_URL: URL do Supabase com pooling de conexões (porta 6543)
DATABASE_URL="postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: URL do Supabase de conexão direta (porta 5432)
DIRECT_URL="postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# HTTP Server configuration
PORT=3001
NODE_ENV=development

# JWT & Cookie secrets (Must be set in production!)
JWT_SECRET="YOUR_SUPER_SECRET_JWT_KEY_MIN_32_CHARS_LONG"
JWT_REFRESH_SECRET="A_DIFFERENT_SUPER_SECRET_REFRESH_KEY_MIN_32_CHARS"
COOKIE_SECRET="YOUR_SUPER_SECRET_COOKIE_PARSER_SECRET"

# Allowed CORS origins (Comma separated URLs)
FRONTEND_URL="http://localhost:3000"

# Redis Cache configuration
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Google reCAPTCHA v3 (a chave secreta nunca deve ser exposta ao frontend)
RECAPTCHA_SECRET_KEY="sua-chave-secreta-recaptcha-v3"
RECAPTCHA_MIN_SCORE="0.5"

# Supabase Auth credentials used by the backend
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="sua-chave-anon-aqui"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-aqui"
