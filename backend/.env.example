# Database Configuration
# Direct connection string is used for migrations, connection string is used for pool
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventease?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/eventease?schema=public"

# HTTP Server configuration
PORT=3000
NODE_ENV=development

# JWT & Cookie secrets (Must be set in production!)
JWT_SECRET="YOUR_SUPER_SECRET_JWT_KEY_MIN_32_CHARS_LONG"
COOKIE_SECRET="YOUR_SUPER_SECRET_COOKIE_PARSER_SECRET"

# Allowed CORS origins (Comma separated URLs)
FRONTEND_URL="http://localhost:3000"

# Supabase Integration (Service Role is needed to perform admin actions like updating user roles)
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# Fallback key if service role key is not configured
SUPABASE_KEY="your-supabase-anon-key"
