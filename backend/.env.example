# Database Configuration (PostgreSQL)
# DATABASE_URL: usada pela API em runtime (pode incluir pooling, ex.: PgBouncer)
DATABASE_URL="postgresql://usuario:senha@host:5432/eventease"
# DIRECT_URL: usada pelas migrations do Prisma (conexão direta)
DIRECT_URL="postgresql://usuario:senha@host:5432/eventease"

# HTTP Server configuration
PORT=3001
NODE_ENV=development

# JWT & Cookie secrets (Must be set in production!)
JWT_SECRET="YOUR_SUPER_SECRET_JWT_KEY_MIN_32_CHARS_LONG"
JWT_REFRESH_SECRET="A_DIFFERENT_SUPER_SECRET_REFRESH_KEY_MIN_32_CHARS"
COOKIE_SECRET="YOUR_SUPER_SECRET_COOKIE_PARSER_SECRET"

# Allowed CORS origins (Comma separated URLs)
FRONTEND_URL="http://localhost:3000"

# Redis Cache configuration
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Google reCAPTCHA v3 (a chave secreta nunca deve ser exposta ao frontend)
RECAPTCHA_SECRET_KEY="sua-chave-secreta-recaptcha-v3"
RECAPTCHA_MIN_SCORE="0.5"

