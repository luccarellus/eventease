{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "node_modules/.prisma/client/libquery_engine-*",
        "backend/dist/**"
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
